#include <iostream>

#include "mylib.h"

#include "SDL3/SDL.h"
#include "SDL3_mixer/SDL_mixer.h"

MIX_Audio *load_sound(const char *filepath) {
	MIX_Audio *sound = MIX_LoadAudio(get_mixer(), filepath, true);
	
	return sound;
}

void play_sound(MIX_Audio *sound) {
	MIX_PlayAudio(get_mixer(), sound);
}
