void Explosion::init(void) {
  this->x = -16.0f;
  this->y = -16.0f;
  this->lifetime = 0.0f;
}

void Explosion::reset(void) {
  this->x = -16.0f;
  this->y = -16.0f;
  this->lifetime = 0.0f;
}

bool Explosion::out_of_bounds(void) {
  return this->y < 0.0f;
}

void Explosion::update(float dt) {
  this->lifetime -= dt;

  if (this->lifetime <= 0.0f) {
    this->reset();
  }
}

void Explosion::spawn(float x, float y) {
  this->x = x;
  this->y = y;
  this->lifetime = EXPLOSION_TIME;
}

