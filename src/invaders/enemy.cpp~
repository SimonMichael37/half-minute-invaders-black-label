const float SPAWN_TIME = 0.3f;
float spawn_timer = 0.0f;

void EnemyManager::init(void) {
  for (int i = 0; i < ENEMY_NUM; i++) {
    this->enemies[i].init();
  }

  spawn_timer = 0.0f;
}

void EnemyManager::reset(void) {
  for (int i = 0; i < ENEMY_NUM; i++) {
    this->enemies[i].reset();
  }
}

void EnemyManager::spawn(void) {
	// 14.0f

  for (int i = 0; i < ENEMY_NUM; i++) {
    if ( this->enemies[i].out_of_bounds() ) {
      float rand_x = (float) ((rand() % 121) + 4);
      this->enemies[i].spawn(rand_x, 10.0f);
      break;
    }
  }
}

void EnemyManager::update(float dt) {
  for (int i = 0; i < ENEMY_NUM; i++) {
    if ( !(this->enemies[i].out_of_bounds()) ) {
      this->enemies[i].move(dt);
    }
  }

  spawn_timer += dt;
  if (spawn_timer >= SPAWN_TIME) {
    this->spawn();
    spawn_timer = 0.0f;
  }
}

