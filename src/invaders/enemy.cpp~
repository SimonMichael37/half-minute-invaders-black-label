void ExplosionManager::init(void) {
  for (int i = 0; i < EXPLOSION_NUM; i++) {
    this->explosions[i].init();
  }
}

void ExplosionManager::reset(void) {
  for (int i = 0; i < EXPLOSION_NUM; i++) {
    this->explosions[i].reset();
  }
}

void ExplosionManager::spawn(float x, float y) {
  for (int i = 0; i < EXPLOSION_NUM; i++) {
    if ( this->explosions[i].out_of_bounds() ) {
      this->explosions[i].spawn(x, y);
      break;
    }
  }
}

void ExplosionManager::update(float dt) {
  for (int i = 0; i < EXPLOSION_NUM; i++) {
    if ( !(this->explosions[i].out_of_bounds()) ) {
      this->explosions[i].update(dt);
    }
  }
}

