#include <cstdlib>
#include <cmath>

#include "SDL3/SDL.h"

#include "invaders/enemy.h"

static const float AMPLITUDE = 8.0f;
static const float FREQUENCY = 0.1f;

void Enemy::init(void) {
  this->x = 130.0f;
  this->y = 130.0f;
	this->base_x = 130.0f;

  this->hitbox.w = 10.0f;
  this->hitbox.h = 8.0f;
  this->hitbox.x = this->x - 5.0f;
  this->hitbox.y = this->y - 4.0f;
}

void Enemy::reset(void) {
  this->x = 130.0f;
  this->y = 130.0f;
	this->base_x = 130.0f;

  this->hitbox.x = this->x - 5.0f;
  this->hitbox.y = this->y - 4.0f;
}

bool Enemy::out_of_bounds(void) {
  return this->y > 128.0f;
}

void Enemy::spawn(float x, float y) {
  this->x = x;
  this->y = y;
	this->base_x = x;

  this->hitbox.x = this->x - 5.0f;
  this->hitbox.y = this->y - 4.0f;
}

void Enemy::move(float dt) {
  this->y += 50.0f * dt;

	this->x = this->base_x + AMPLITUDE * std::sin(this->y * FREQUENCY);

  this->hitbox.x = this->x - 5.0f;
  this->hitbox.y = this->y - 4.0f;
}

