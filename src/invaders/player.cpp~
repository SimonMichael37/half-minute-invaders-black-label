#include "SDL3/SDL.h"

#include "invaders/player.h"

void Player::init(void) {
  this->x = 64.0f;
  this->y = 112.0f;

  this->hitbox.w = 6.0f;
  this->hitbox.h = 3.0f;
  this->hitbox.x = this->x - 3.0f;
  this->hitbox.y = this->y + 1.0f;
}

void Player::reset(void) {
  this->x = 64.0f;
  this->y = 112.0f;

  this->hitbox.x = this->x - 3.0f;
  this->hitbox.y = this->y + 1.0f;
}

void Player::move(int move_x, float dt) {
  this->x += move_x * 50.0f * dt;

  if (this->x < 4.0f) {
    this->x = 4.0f;
  } else if (this->x > 124.0f) {
    this->x = 124.0f;
  }

  this->hitbox.x = this->x - 3.0f;
  this->hitbox.y = this->y + 1.0f;
}

