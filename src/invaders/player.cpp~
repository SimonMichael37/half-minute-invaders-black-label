void Bullet::init(void) {
  this->x = -8.0f;
  this->y = -8.0f;

  this->hitbox.w = 2.0f;
  this->hitbox.h = 8.0f;
  this->hitbox.x = this->x - 1.0f;
  this->hitbox.y = this->y - 4.0f;
}

void Bullet::reset(void) {
  this->x = -8.0f;
  this->y = -8.0f;

  this->hitbox.x = this->x - 1.0f;
  this->hitbox.y = this->y - 4.0f;
}

void Bullet::shoot(float x, float y) {
  this->x = x;
  this->y = y;

  this->hitbox.x = this->x - 1.0f;
  this->hitbox.y = this->y - 4.0f;
}

void Bullet::move(float dt) {
  this->y -= 200.0f * dt;

  this->hitbox.x = this->x - 1.0f;
  this->hitbox.y = this->y - 4.0f;
}

bool Bullet::out_of_bounds(void) {
  return this->y < 0.0f;
}
